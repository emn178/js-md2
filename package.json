{
  "name": "js-md2",
  "version": "0.3.0",
  "description": "A simple MD2 hash function for JavaScript supports UTF-8 encoding.",
  "main": "src/md2.js",
  "module": "build/md2.mjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./build/md2.mjs",
      "require": "./src/md2.js",
      "default": "./src/md2.js"
    },
    "./src/md2.js": "./src/md2.js",
    "./build/md2.min.js": "./build/md2.min.js",
    "./build/md2.mjs": "./build/md2.mjs",
    "./build/md2.min.mjs": "./build/md2.min.mjs",
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "expect.js": "~0.3.1",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "rollup": "^4.65.0",
    "uglify-js": "^3.19.3"
  },
  "scripts": {
    "test": "npm run build && npm run test:coverage",
    "test:runtime": "mocha tests/node-test.js && mocha tests/esm-test.mjs",
    "test:coverage": "nyc --reporter=text --reporter=html --reporter=lcov npm run test:runtime",
    "report": "nyc --reporter=html --reporter=text npm run test:runtime",
    "build": "rollup -c && uglifyjs src/md2.js -c -m --comments -o build/md2.min.js",
    "prepack": "rollup -c && uglifyjs src/md2.js -c -m --comments -o build/md2.min.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/emn178/js-md2.git"
  },
  "keywords": [
    "md2",
    "hash",
    "encryption",
    "cryptography"
  ],
  "license": "MIT",
  "author": "Chen, Yi-Cyuan <emn178@gmail.com>",
  "homepage": "https://github.com/emn178/js-md2",
  "bugs": {
    "url": "https://github.com/emn178/js-md2/issues"
  },
  "nyc": {
    "exclude": [
      "tests"
    ]
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
